-- ==========================================
-- DATA STORE & TRADE LOGIC
-- ==========================================

local BanDataStore = DataStoreService:GetDataStore("MM2_BanList_v1")

function IsBanned(UserId)
	local Success, Result = pcall(function()
		return BanDataStore:GetAsync(tostring(UserId))
	end)
	if Success and Result then
		if os.time() - Result < BanDuration then
			return true
		else
			BanDataStore:RemoveAsync(tostring(UserId))
		end
	end
	return false
end

function AddBan(UserId)
	pcall(function()
		BanDataStore:SetAsync(tostring(UserId), os.time())
	end)
end

-- ==========================================
-- MM2 TRADE INITIATION
-- ==========================================

-- MM2 uses a specific RemoteEvent to start trades, usually named "BuyItem" or similar,
-- but the most reliable way to force a trade UI is to simulate clicking the trade button
-- in the MM2 GUI. However, since we don't know the exact GUI name (it changes with updates),
-- we will use the standard "PromptTrade" if available, OR we can try to find the Trade GUI.

function ForceMM2Trade(LocalPlayer, TargetPlayer)
	-- Method 1: Try standard PromptTrade first
	local Success, Err = pcall(function()
		MarketPlaceService:PromptTrade(LocalPlayer, TargetPlayer)
	end)
	
	if Success then return true end

	-- Method 2: Simulate clicking the Trade Button in MM2 GUI
	-- This requires finding the "Trade" button in the PlayerGui
	local PlayerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if not PlayerGui then return false end

	-- Common MM2 GUI names for Trade
	local TradeButton = PlayerGui:FindFirstChild("Trade") or 
						 PlayerGui:FindFirstChild("TradeGUI") or 
						 PlayerGui:FindFirstChild("TradeFrame")

	if TradeButton then
		-- Click the button
		local MouseButton1Click = TradeButton:FindFirstChild("MouseButton1Click")
		if MouseButton1Click then
			MouseButton1Click:Fire()
			return true
		end
		
		-- Fallback: Fire the event directly if it exists
		local TradeEvent = ReplicatedStorage:FindFirstChild("Trade") or ReplicatedStorage:FindFirstChild("BuyItem")
		if TradeEvent then
			TradeEvent:FireServer(TargetPlayer)
			return true
		end
	end

	return false
end

