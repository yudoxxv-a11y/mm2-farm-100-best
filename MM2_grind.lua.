		"KRNL", "FluxusUI", "SynapseUI"
	}

	for _, ModuleName in ipairs(ExecutorModules) do
		if PlayerScripts:FindFirstChild(ModuleName) or PlayerScripts:FindFirstChild(ModuleName:lower()) then
			return true
		end
	end

	-- 2. Check for known Executor Global Variables (_G)
	if _G.Synapse or _G.Krnl or _G.Fluxus or _G.ArceusX or _G.Hydrogen then
		return true
	end

	-- 3. Check for known MM2-specific exploit signs
	-- Some executors inject a specific "Client" object or modify MM2's GameInfo
	local GameInfo = ReplicatedStorage:FindFirstChild("GameInfo")
	if GameInfo and GameInfo:IsA("StringValue") then
		-- If GameInfo is missing or malformed, it might be an exploit
		-- This is a heuristic check
	end

	return false
end

function GetExecutorType(Player)
	local PlayerScripts = Player:FindFirstChildOfClass("PlayerScripts")
	if not PlayerScripts then return "Unknown" end

	local KnownTypes = {
		["Synapse"] = "Synapse X", ["SynapseX"] = "Synapse X",
		["Fluxus"] = "Fluxus", ["FluxusUI"] = "Fluxus",
		["Krnl"] = "KRNL", ["KRNL"] = "KRNL",
		["Hydrogen"] = "Hydrogen",
		["ArceusX"] = "Arceus X",
		["Codex"] = "Codex",
		["ScriptWare"] = "ScriptWare",
		["Delta"] = "Delta",
		["Solara"] = "Solara"
	}

	for _, Name in pairs(KnownTypes) do
		if PlayerScripts:FindFirstChild(Name) then
			return Name
		end
	end
	
	if _G.Synapse then return "Synapse X" end
	if _G.Krnl then return "KRNL" end
	if _G.Fluxus then return "Fluxus" end
	if _G.Hydrogen then return "Hydrogen" end
	if _G.ArceusX then return "Arceus X" end

	return "Unknown Executor"
end

